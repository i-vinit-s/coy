{
  "name": "coy-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "express": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "supertest": "^7.1.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0",
      "effect": "^3.21.0"
    }
  },
  "allowScripts": {
    "@prisma/client@6.19.0": true,
    "prisma@6.19.0": true,
    "@prisma/engines@6.19.0": true
  }
}
